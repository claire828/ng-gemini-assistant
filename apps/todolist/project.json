{
  "name": "todolist",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/todolist/src",
  "tags": [],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {},
      "configurations": {},
      "parallelism": true,
      "dependsOn": [],
      "inputs": [
        "default",
        "{projectRoot}/**/*.{ts,tsx,js,jsx,html}",
        "{workspaceRoot}/eslint.config.js"
      ]
    },
    "build": {
      "executor": "@angular-devkit/build-angular:browser-esbuild",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/apps/todolist",
        "index": "apps/todolist/src/index.html",
        "main": "apps/todolist/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/todolist/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/todolist/public"
          }
        ],
        "styles": [
          "apps/todolist/src/styles.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "2kb",
              "maximumError": "4kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production",
      "parallelism": true,
      "dependsOn": [
        "^build"
      ]
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "todolist:build:production"
        },
        "development": {
          "buildTarget": "todolist:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {},
      "parallelism": true
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "todolist:build"
      },
      "configurations": {},
      "parallelism": true
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/todolist/jest.config.ts"
      },
      "configurations": {},
      "parallelism": true,
      "dependsOn": [
        "^test"
      ]
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "todolist:build",
        "port": 4200,
        "staticFilePath": "dist/apps/todolist/browser",
        "spa": true
      },
      "configurations": {},
      "parallelism": true
    }
  },
  "implicitDependencies": []
}