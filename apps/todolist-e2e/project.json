{
  "name": "todolist-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/todolist-e2e/src",
  "tags": [],
  "implicitDependencies": [
    "todolist"
  ],
  "// targets": "to see all targets run: nx show project todolist-e2e --web",
  "targets": {
    "e2e": {
      "options": {
        "cwd": "apps/todolist-e2e",
        "command": "cypress run"
      },
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "cypress"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/cypress/apps/todolist-e2e/videos",
        "{workspaceRoot}/dist/cypress/apps/todolist-e2e/screenshots"
      ],
      "parallelism": true,
      "metadata": {
        "technologies": [
          "cypress"
        ],
        "description": "Runs Cypress Tests",
        "help": {
          "command": "npx cypress run --help",
          "example": {
            "args": [
              "--dev",
              "--headed"
            ]
          }
        }
      },
      "configurations": {
        "production": {
          "command": "cypress run --env webServerCommand=\"npx nx run todolist:serve-static\""
        }
      },
      "executor": "nx:run-commands",
      "dependsOn": [
        "^build"
      ]
    },
    "e2e-ci--src/e2e/app.cy.ts": {
      "outputs": [
        "{workspaceRoot}/dist/cypress/apps/todolist-e2e/videos",
        "{workspaceRoot}/dist/cypress/apps/todolist-e2e/screenshots"
      ],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "cypress"
          ]
        }
      ],
      "cache": true,
      "options": {
        "cwd": "apps/todolist-e2e",
        "command": "cypress run --env webServerCommand=\"npx nx run todolist:serve-static\" --spec src/e2e/app.cy.ts --config='{\"baseUrl\": \"http://localhost:4200\"}'"
      },
      "parallelism": false,
      "metadata": {
        "technologies": [
          "cypress"
        ],
        "description": "Runs Cypress Tests in src/e2e/app.cy.ts in CI",
        "help": {
          "command": "npx cypress run --help",
          "example": {
            "args": [
              "--dev",
              "--headed"
            ]
          }
        }
      },
      "executor": "nx:run-commands",
      "configurations": {}
    },
    "e2e-ci": {
      "executor": "nx:noop",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "cypress"
          ]
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/cypress/apps/todolist-e2e/videos",
        "{workspaceRoot}/dist/cypress/apps/todolist-e2e/screenshots"
      ],
      "dependsOn": [
        {
          "target": "e2e-ci--src/e2e/app.cy.ts",
          "projects": "self",
          "params": "forward"
        }
      ],
      "parallelism": false,
      "metadata": {
        "technologies": [
          "cypress"
        ],
        "description": "Runs Cypress Tests in CI",
        "nonAtomizedTarget": "e2e",
        "help": {
          "command": "npx cypress run --help",
          "example": {
            "args": [
              "--dev",
              "--headed"
            ]
          }
        }
      },
      "configurations": {},
      "options": {}
    },
    "open-cypress": {
      "options": {
        "cwd": "apps/todolist-e2e",
        "command": "cypress open"
      },
      "metadata": {
        "technologies": [
          "cypress"
        ],
        "description": "Opens Cypress",
        "help": {
          "command": "npx cypress open --help",
          "example": {
            "args": [
              "--dev",
              "--e2e"
            ]
          }
        }
      },
      "executor": "nx:run-commands",
      "configurations": {},
      "parallelism": true
    },
    "lint": {
      "cache": true,
      "options": {
        "cwd": "apps/todolist-e2e",
        "command": "eslint ."
      },
      "inputs": [
        "default",
        "{projectRoot}/**/*.{ts,tsx,js,jsx,html}",
        "{workspaceRoot}/eslint.config.js"
      ],
      "outputs": [
        "{options.outputFile}"
      ],
      "metadata": {
        "technologies": [
          "eslint"
        ],
        "description": "Runs ESLint on project",
        "help": {
          "command": "npx eslint --help",
          "example": {
            "options": {
              "max-warnings": 0
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "configurations": {},
      "parallelism": true,
      "dependsOn": []
    }
  }
}