{
  "name": "shared-express",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared-express/src",
  "projectType": "library",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared-express",
        "tsConfig": "libs/shared-express/tsconfig.lib.json",
        "packageJson": "libs/shared-express/package.json",
        "main": "libs/shared-express/src/index.ts",
        "assets": ["libs/shared-express/*.md"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/shared-express/jest.config.ts"
      }
    }
  }
}
